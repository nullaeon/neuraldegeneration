# Tokenizer config
tokenizer_path: training/tokenizer/tokenizer.json
tokenizer_s3_uri: s3://nullaeon-cc-models/tokenizer/tokenizer.json

# Dataset selection from S3
english_glob: training/data/english_only_subset/*.txt
generated_glob: NONE
max_english_files: 100
max_generated_files: 0

# S3 dataset URIs (downloaded into data/s3_cache/)
dataset_s3_uris:
  - s3://nullaeon-cc-datasets/data/english_only_subset/

# Output directories
output_dir: output/cloud_dev_test
model_name: cloud_dev_test_model

# Training parameters (lightweight)
block_size: 128
batch_size: 2
gradient_accum_steps: 2
epochs: 1
learning_rate: 5e-4
warmup_steps: 10
weight_decay: 0.01
save_limit: 1

# Upload path for trained model
model_s3_upload_path: s3://nullaeon-cc-models/models/cloud_dev_test_model/
